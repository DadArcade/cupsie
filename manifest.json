{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.11.7",
  "default_locale": "en",
  "description": "__MSG_extDesc__",
  "icons": {
    "16": "cupsie16.png",
    "32": "cupsie32.png",
    "48": "cupsie48.png",
    "128": "cupsie128.png"
  },
  "permissions": [
    "printerProvider",
    "storage",
    "alarms"
  ],
  "storage": {
    "managed_schema": "schema.json"
  },
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html"
}